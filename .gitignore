# ---- Android / Gradle 构建产物 ----
app/.gradle/
app/build/
app/app/build/
app/local.properties
*.apk.bak
app/app/*.iml

# ---- 本地工具链（2GB SDK + JDK，不入库）----
android-dev/

# ---- 图片中间产物（成品已压缩进 assets/dishes）----
images_raw/
generated-images/
img_test/

# ---- 字体原文件（16MB/个，成品子集已在 app/app/src/main/assets/fonts）----
app/data/fonts_backup/

